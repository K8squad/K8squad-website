#!/bin/bash

# start-backup-coder - Start the backup coder process
# This script replaces the missing executable referenced by enhanced-resume-backup_coder.sh

set -e

# Configuration
BINARY_PATH="/mnt/nas/project/ksquad/memory"
CONFIG_PATH="./memory-config.json"
LOG_DIR="./logs"
HTTP_PORT="8080"
PID_FILE="./backup-coder.pid"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check prerequisites
check_prerequisites() {
    log_info "Checking prerequisites..."
    
    # Check if binary exists
    if [ ! -f "$BINARY_PATH" ]; then
        log_error "Memory binary not found: $BINARY_PATH"
        exit 1
    fi
    
    # Check if binary is executable
    if [ ! -x "$BINARY_PATH" ]; then
        log_error "Memory binary is not executable: $BINARY_PATH"
        exit 1
    fi
    
    # Create log directory if it doesn't exist
    if [ ! -d "$LOG_DIR" ]; then
        log_warn "Log directory not found, creating: $LOG_DIR"
        mkdir -p "$LOG_DIR"
    fi
    
    # Create log directory if it doesn't exist
    if [ ! -d "$LOG_DIR" ]; then
        log_warn "Log directory not found, creating: $LOG_DIR"
        sudo mkdir -p "$LOG_DIR"
    fi
    
    log_info "Prerequisites check passed."
}

# Generate default config if not exists
generate_config() {
    local config_file="$CONFIG_PATH"
    
    if [ ! -f "$config_file" ]; then
        log_info "Generating default config file: $config_file"
        
        cat > "$config_file" << EOF
{
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "ksquad",
    "user": "postgres",
    "password": "password",
    "ssl_mode": "disable"
  },
  "http": {
    "port": $HTTP_PORT,
    "host": "localhost"
  },
  "logging": {
    "level": "info",
    "file": "$LOG_DIR/memory.log"
  },
  "backup": {
    "health_check_interval": "30s",
    "max_retries": 3,
    "timeout": "10s"
  }
}
EOF
    fi
}

# Check if process is already running
check_process_running() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            log_info "Backup coder process already running with PID: $pid"
            return 0
        else
            log_warn "Stale PID file found, removing: $PID_FILE"
            rm -f "$PID_FILE"
        fi
    fi
    return 1
}

# Start the backup coder process
start_process() {
    log_info "Starting backup coder process..."
    
    # Check if already running
    if check_process_running; then
        return 0
    fi
    
    # Build command
    local cmd="$BINARY_PATH --config $CONFIG_PATH --http-port $HTTP_PORT"
    
    # Start process with logging
    nohup $cmd > "$LOG_DIR/memory.log" 2>&1 &
    local pid=$!
    
    # Store PID
    echo $pid > "$PID_FILE"
    
    log_info "Backup coder process started with PID: $pid"
    log_info "Log file: $LOG_DIR/memory.log"
    log_info "Config file: $CONFIG_PATH"
    log_info "HTTP endpoint: http://localhost:$HTTP_PORT/health"
}

# Check process health
check_process_health() {
    if ! check_process_running; then
        log_error "Backup coder process is not running"
        return 1
    fi
    
    local pid=$(cat "$PID_FILE")
    
    # Check if process is responsive
    if ! ps -p "$pid" > /dev/null 2>&1; then
        log_error "Backup coder process with PID $pid is not responding"
        return 1
    fi
    
    # Check health endpoint if available
    if command -v curl >/dev/null 2>&1; then
        local health_url="http://localhost:$HTTP_PORT/health"
        if curl -f "$health_url" >/dev/null 2>&1; then
            log_info "Backup coder process is healthy (PID: $pid)"
            return 0
        else
            log_warn "Backup coder process health check failed for PID: $pid"
            return 1
        fi
    else
        log_info "Backup coder process is running (PID: $pid)"
        return 0
    fi
}

# Stop the backup coder process
stop_process() {
    if check_process_running; then
        local pid=$(cat "$PID_FILE")
        log_info "Stopping backup coder process with PID: $pid"
        
        kill -TERM "$pid"
        
        # Wait for graceful shutdown
        for i in {1..10}; do
            if ! ps -p "$pid" > /dev/null 2>&1; then
                log_info "Backup coder process stopped gracefully"
                rm -f "$PID_FILE"
                return 0
            fi
            sleep 1
        done
        
        # Force kill if still running
        log_warn "Force killing backup coder process with PID: $pid"
        kill -KILL "$pid"
        sleep 1
        
        if ps -p "$pid" > /dev/null 2>&1; then
            log_error "Failed to stop backup coder process with PID: $pid"
            return 1
        fi
        
        rm -f "$PID_FILE"
        log_info "Backup coder process stopped"
        return 0
    else
        log_info "Backup coder process is not running"
        return 0
    fi
}

# Show process status
show_status() {
    if check_process_running; then
        local pid=$(cat "$PID_FILE")
        log_info "Backup coder process is running with PID: $pid"
        log_info "Memory usage:"
        ps -p "$pid" -o pid,ppid,%cpu,%mem,cmd --no-headers
        log_info "Recent log entries:"
        tail -n 10 "$LOG_DIR/memory.log"
    else
        log_info "Backup coder process is not running"
    fi
}

# Main function
main() {
    case "${1:-start}" in
        start)
            check_prerequisites
            generate_config
            start_process
            check_process_health
            ;;
        stop)
            stop_process
            ;;
        restart)
            stop_process
            sleep 2
            check_prerequisites
            generate_config
            start_process
            check_process_health
            ;;
        status)
            show_status
            ;;
        health)
            if check_process_health; then
                exit 0
            else
                exit 1
            fi
            ;;
        *)
            echo "Usage: $0 {start|stop|restart|status|health}"
            echo "  start   - Start the backup coder process"
            echo "  stop    - Stop the backup coder process"
            echo "  restart - Restart the backup coder process"
            echo "  status  - Show process status"
            echo "  health  - Check process health"
            exit 1
            ;;
    esac
}

# Error handling
trap 'log_error "Script failed at line $LINENO"; exit 1' ERR

# Run main function
main "$@"