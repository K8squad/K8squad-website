---
// K8squad landing page (k8squad.io). Standalone Astro page — sits at `/` outside
// Starlight, which owns `/docs/**`. Copy is sourced from content/landing.md; the
// visual system follows the locked design (dark-primary, Squad Azure #3D7DFF).
const features = [
  {
    n: '01',
    icon: '/icons/feat-orchestrate.svg',
    title: 'Orchestrate the agent — don’t reimplement it',
    body: 'Runtime-agnostic. Claude Code, OpenClaw, Hermes and others plug in behind one shim contract (A2A southbound, MCP for tools). Swap or mix runtimes without rewriting your platform.',
  },
  {
    n: '02',
    icon: '/icons/feat-reconcile.svg',
    title: 'A reconcile control plane, not heartbeat glue',
    body: 'Every unit of work is a Run — a reconciled workload with a crash-safe state machine. A controller restart never double-drives a Run, and no coordination state is trapped in a dead pod.',
  },
  {
    n: '03',
    icon: '/icons/feat-workitems.svg',
    title: 'Durable, first-class work items',
    body: 'Coordination is a durable Postgres record — checkout, claim, lease, fencing, audit — not agents DMing each other. At most one agent holds a work item at a time; crashed work is safely reclaimed.',
  },
  {
    n: '04',
    icon: '/icons/feat-credentials.svg',
    title: 'Bring your own credentials — and your own model',
    body: 'Each agent authenticates with a per-user Kubernetes Secret on its own subscription. Connect Claude with one OAuth click; a controller keeps the token fresh. Prefer a local model? Point at your own endpoint.',
  },
  {
    n: '05',
    icon: '/icons/feat-safe.svg',
    title: 'Safe by construction',
    body: 'Untrusted agent code runs in warm-pool sandboxes (gVisor by default) with per-squad namespaces, RBAC, and NetworkPolicy egress control. A compromised agent can’t fabricate a Run or escape its namespace.',
  },
  {
    n: '06',
    icon: '/icons/feat-legible.svg',
    title: 'Legible from install to incident',
    body: 'A web console shows your fleet, live Run streams over SSE, build artifacts, per-project dashboards, and a full audit trail. Ship telemetry anywhere with an opt-in OTelConfig CRD.',
  },
  {
    n: '07',
    icon: '/icons/feat-quickstart.svg',
    title: 'One afternoon to first squad',
    body: 'One helm install brings up the operator, apiserver, memory service, console, Postgres, and event bus. Sane defaults and a quickstart get you from empty cluster to first running squad in an afternoon.',
  },
];

const intro = [
  {
    title: 'Kubernetes-native',
    body: 'Squads are CRDs. A Go operator reconciles them the way Kubernetes already reconciles Deployments and Jobs — same tooling, same RBAC, same operator surface.',
  },
  {
    title: 'Agent-agnostic',
    body: 'Any coding agent plugs in behind one documented shim contract. KSquad orchestrates the crew; it never tries to be the agent.',
  },
  {
    title: 'Credential-honest',
    body: 'Every agent runs on its own user’s subscription. KSquad never holds a shared master credential, and your source never leaves your cluster.',
  },
];

const steps = [
  { n: '1', title: 'Install the control plane', body: 'helm install KSquad. You get the operator, apiserver, memory service, and console, with Postgres and NATS bundled as boring subcharts.' },
  { n: '2', title: 'Connect a credential & define agents', body: 'Click Connect Claude once, then declare 2–3 Agents from the bundled runtimes. Each has a Role and Skills.' },
  { n: '3', title: 'Point at a repo & form a squad', body: 'Create a Project (a repo + a workspace) and group your agents into a Team. That’s your squad.' },
  { n: '4', title: 'Start a Run', body: 'Kick off a Run from the console or with kubectl apply. Watch progress stream live and inspect the artifacts.' },
];

const screens = [
  { src: '/screens/01-squad-overview.png', alt: 'Squad overview — fleet of agents in formation' },
  { src: '/screens/08-fleet-dashboard.png', alt: 'Fleet dashboard' },
  { src: '/screens/02-run-stream-sse.png', alt: 'Live Run stream over SSE' },
  { src: '/screens/10-agent-runs.png', alt: 'Agent runs' },
  { src: '/screens/19-project-dashboard.png', alt: 'Per-project dashboard' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>K8squad — Run a squad of AI agents as a Kubernetes-native workload</title>
    <meta
      name="description"
      content="KSquad is a Kubernetes-native, agent-agnostic control plane for running a squad of AI agents against a shared backlog — reconciled, isolated, and legible like any other cluster workload."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://k8squad.io/" />
    <meta property="og:title" content="K8squad — your agents, in formation" />
    <meta
      property="og:description"
      content="A Kubernetes-native, agent-agnostic control plane for running a squad of AI agents against a shared backlog."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://k8squad.io/" />
    <meta property="og:image" content="https://k8squad.io/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
    />
    <!-- Apply persisted theme before paint; shares Starlight's localStorage key so
         the toggle stays consistent between the landing page and the docs. -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('starlight-theme');
        const theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">
        <img src="/mark-8crest.svg" alt="" width="28" height="28" />
        <span class="wordmark">K<span class="eight">8</span>squad</span>
      </a>
      <nav class="nav-links">
        <a href="/docs">Docs</a>
        <a href="/docs/concepts">Concepts</a>
        <a href="/docs/plugin-sdk">Plugin SDK</a>
        <a href="https://github.com/K8squad">GitHub</a>
      </nav>
      <div class="nav-actions">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme">◐</button>
        <a class="btn btn-primary" href="/docs/quickstart">Get started</a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Kubernetes-native · Agent-agnostic · Open source</p>
          <h1>Your agents, in formation.</h1>
          <p class="lede">
            KSquad is a Kubernetes-native control plane for running a <em>squad</em> of AI agents
            against a shared backlog. It treats a crew of agents as a first-class, reconciled
            workload — the way Kubernetes already treats Deployments and Jobs. You keep your
            credentials, your source, and your runtime of choice.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/docs/quickstart">Get started in &lt;30 min →</a>
            <a class="btn btn-ghost" href="/docs/concepts">Read the concepts</a>
          </div>
          <pre class="helm"><code>helm install ksquad ksquad/ksquad --namespace ksquad-system --create-namespace</code></pre>
        </div>
        <div class="hero-art">
          <img src="/hero-art.svg" alt="KSquad fleet overview" loading="eager" />
        </div>
      </section>

      <!-- What is KSquad -->
      <section class="band">
        <h2 class="section-title">What is KSquad</h2>
        <div class="cards-3">
          {intro.map((c) => (
            <article class="card">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Features -->
      <section class="band">
        <h2 class="section-title">What makes KSquad different</h2>
        <div class="features">
          {features.map((f) => (
            <article class="feature">
              <div class="feature-head">
                <img class="feature-icon" src={f.icon} alt="" width="42" height="42" loading="lazy" />
                <span class="feature-n">{f.n}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- How it works -->
      <section class="band">
        <h2 class="section-title">How it works</h2>
        <div class="steps">
          {steps.map((s) => (
            <article class="step">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Screenshots -->
      <section class="band">
        <h2 class="section-title">See it running</h2>
        <div class="carousel" role="region" aria-label="Console screenshots">
          {screens.map((s) => (
            <figure class="shot">
              <img src={s.src} alt={s.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </section>

      <!-- Get started -->
      <section class="band get-started">
        <h2 class="section-title">Get started</h2>
        <p class="lede center">Empty cluster to first running squad in under an afternoon.</p>
        <pre class="helm big"><code>helm repo add ksquad https://k8squad.io/charts
helm install ksquad ksquad/ksquad --namespace ksquad-system --create-namespace</code></pre>
        <div class="cta-row center">
          <a class="btn btn-primary" href="/docs/quickstart">Read the quickstart →</a>
          <a class="btn btn-ghost" href="/docs">Browse the docs</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="foot-cols">
        <div>
          <span class="wordmark small">K<span class="eight">8</span>squad</span>
          <p class="muted">Your agents, in formation.</p>
        </div>
        <div>
          <h4>Product</h4>
          <a href="/docs/quickstart">Quickstart</a>
          <a href="/docs/concepts">Concepts</a>
          <a href="/docs/operator-guide">Operator Guide</a>
        </div>
        <div>
          <h4>Docs</h4>
          <a href="/docs">Overview</a>
          <a href="/docs/plugin-sdk">Plugin SDK</a>
          <a href="/docs/api-reference">API Reference</a>
        </div>
        <div>
          <h4>Community</h4>
          <a href="https://github.com/K8squad">GitHub</a>
          <a href="/docs/troubleshooting">Troubleshooting</a>
        </div>
      </div>
      <div class="foot-legal">
        <span class="muted">Apache 2.0 · © 2026 K8squad</span>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
      });
    </script>

    <style is:global>
      :root {
        --azure: #3d7dff;
        --font: 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        --mono: 'Geist Mono', ui-monospace, 'SFMono-Regular', 'Menlo', monospace;
      }
      html[data-theme='dark'] {
        --bg: #0f1117;
        --card: #1a1d29;
        --border: #262b3a;
        --text: #e8eef9;
        --text-2: #b6c3d8;
        --text-3: #7e8ca6;
        --nav-bg: rgba(15, 17, 23, 0.8);
      }
      html[data-theme='light'] {
        --bg: #f6f8fc;
        --card: #ffffff;
        --border: #e2e8f2;
        --text: #10131c;
        --text-2: #38435c;
        --text-3: #5a6883;
        --nav-bg: rgba(246, 248, 252, 0.85);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      code, pre { font-family: var(--mono); }
      a { color: inherit; text-decoration: none; }
      main { display: block; }
      section { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

      /* Nav */
      .nav {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; gap: 24px;
        padding: 14px 24px;
        background: var(--nav-bg); backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; }
      .wordmark { font-size: 1.15rem; letter-spacing: -0.01em; }
      .wordmark.small { font-size: 1rem; }
      .eight { color: var(--azure); }
      .nav-links { display: flex; gap: 22px; margin-left: 12px; color: var(--text-2); font-size: 0.95rem; }
      .nav-links a:hover { color: var(--text); }
      .nav-actions { margin-left: auto; display: flex; align-items: center; gap: 12px; }
      .theme-toggle {
        background: transparent; border: 1px solid var(--border); color: var(--text-2);
        width: 34px; height: 34px; border-radius: 8px; cursor: pointer; font-size: 1rem;
      }
      .theme-toggle:hover { color: var(--text); border-color: var(--azure); }

      .btn {
        display: inline-block; padding: 10px 18px; border-radius: 10px;
        font-weight: 500; font-size: 0.95rem; transition: transform .05s ease, background .15s ease;
      }
      .btn:active { transform: translateY(1px); }
      .btn-primary { background: var(--azure); color: #fff; }
      .btn-primary:hover { background: #2f6bf0; }
      .btn-ghost { border: 1px solid var(--border); color: var(--text); }
      .btn-ghost:hover { border-color: var(--azure); }

      /* Hero */
      .hero {
        max-width: 1120px; margin: 0 auto; padding: 72px 24px 40px;
        display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center;
      }
      .eyebrow { color: var(--azure); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.02em; margin: 0 0 14px; }
      .hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 18px; }
      .lede { color: var(--text-2); font-size: 1.1rem; max-width: 46ch; }
      .lede.center { margin: 0 auto 20px; text-align: center; }
      .cta-row { display: flex; gap: 14px; margin: 26px 0; flex-wrap: wrap; }
      .cta-row.center { justify-content: center; }
      .helm {
        background: #0b0d13; border: 1px solid var(--border); border-radius: 10px;
        padding: 14px 16px; overflow-x: auto; font-size: 0.85rem; color: #cdd6ea; margin: 0;
      }
      .helm.big { max-width: 720px; margin: 18px auto 26px; }
      .hero-art img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: 14px; }

      /* Bands */
      .band { padding: 56px 24px; }
      .section-title { font-size: 1.7rem; letter-spacing: -0.01em; margin: 0 0 28px; }

      .cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px; }
      .card h3 { margin: 0 0 8px; font-size: 1.1rem; }
      .card p { margin: 0; color: var(--text-2); font-size: 0.95rem; }

      .features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
      .feature { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px; }
      .feature-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
      .feature-icon { width: 42px; height: 42px; display: block; }
      .feature-n { color: var(--azure); font-family: var(--mono); font-size: 0.8rem; }
      .feature h3 { margin: 0 0 8px; font-size: 1.08rem; }
      .feature p { margin: 0; color: var(--text-2); font-size: 0.93rem; }

      .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
      .step { position: relative; padding: 22px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
      .step-n {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px; background: var(--azure); color: #fff;
        font-weight: 600; margin-bottom: 12px;
      }
      .step h3 { margin: 0 0 8px; font-size: 1rem; }
      .step p { margin: 0; color: var(--text-2); font-size: 0.9rem; }

      .carousel {
        display: flex; gap: 16px; overflow-x: auto; padding-bottom: 12px;
        scroll-snap-type: x mandatory;
      }
      .shot { flex: 0 0 auto; width: 520px; max-width: 82vw; margin: 0; scroll-snap-align: center; }
      .shot img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: 12px; }

      .get-started { text-align: center; }

      /* Footer */
      .footer { border-top: 1px solid var(--border); margin-top: 40px; padding: 48px 24px 32px; }
      .foot-cols { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 28px; }
      .foot-cols h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 12px; }
      .foot-cols a { display: block; color: var(--text-2); font-size: 0.92rem; padding: 3px 0; }
      .foot-cols a:hover { color: var(--text); }
      .muted { color: var(--text-3); font-size: 0.9rem; }
      .foot-legal { max-width: 1120px; margin: 28px auto 0; padding-top: 20px; border-top: 1px solid var(--border); }

      @media (max-width: 880px) {
        .hero { grid-template-columns: 1fr; padding-top: 40px; }
        .hero-art { order: -1; }
        .cards-3, .features, .steps { grid-template-columns: 1fr; }
        .nav-links { display: none; }
        .foot-cols { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
