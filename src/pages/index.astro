---
// K8squad landing page (k8squad.io). Standalone Astro page — sits at `/` outside
// Starlight, which owns `/docs/**`. Copy is sourced from content/landing.md; the
// visual system follows the locked design (dark-primary, Squad Azure #3D7DFF).
// The 8 product-console features follow the approved mock order (content/landing.md
// @46bc2d6). Icons are intentionally NOT wired here: the old public/icons/feat-*.svg
// glyphs are keyed to the retired value-props and the re-keyed 8-feature set is owned
// by the Graphic Designer (ISI-2471 follow-up). Wire icons in once those land.
const features = [
  {
    n: '01',
    title: 'Project-scoped squads',
    body: 'Every squad lives in its own project and namespace — RBAC-gated and NetworkPolicy-isolated. One team’s agents can’t see, or reach, another team’s work, credentials, or cluster.',
  },
  {
    n: '02',
    title: 'Agent org views',
    body: 'A live org chart of your crew: who leads, who reports to whom, and what each agent is doing right now. Leadership and role views make a running squad legible at a glance.',
  },
  {
    n: '03',
    title: 'Build browser',
    body: 'Every artifact an agent produces — diffs, files, logs — is browsable across every Run and addressable by content hash. Inspect exactly what changed, and where it came from.',
  },
  {
    n: '04',
    title: 'Live runs',
    body: 'Follow a Run as it unfolds over SSE: each tool call, model response, and log line, in order. A controller restart never double-drives a run, so what you see is what actually happened.',
  },
  {
    n: '05',
    title: 'RBAC',
    body: 'Two global roles and three per-project access levels map cleanly onto Kubernetes RBAC — operators run the platform, authors compose the work, and everyone’s access is auditable.',
  },
  {
    n: '06',
    title: 'OTel-native',
    body: 'Traces, metrics, and logs out of the box. An opt-in OTelConfig CRD fans each signal out to any OTLP backend — traces to one destination, metrics to another, logs to a third.',
  },
  {
    n: '07',
    title: 'Plugin SDK',
    body: 'Extend the platform with sandboxed, least-privilege plugins that react to typed events — run.succeeded, workitem.claimed, workitem.handoff, artifact.registered, and more, over durable NATS JetStream subjects. A plugin can never block a run; a flaky endpoint can never stall the platform.',
  },
  {
    n: '08',
    title: 'Responsive',
    body: 'The full operator console — dashboards, kanban, agent org, build browser — adapts from a wide NOC display down to a phone, so you can check a squad from wherever you are.',
  },
];

const intro = [
  {
    title: 'Kubernetes-native',
    body: 'Squads, agents, and runs are CRDs. Deploy with Helm, manage with kubectl. If you can operate a cluster, you can operate a squad — same objects, same RBAC, same reconcile loop.',
  },
  {
    title: 'Agents in formation',
    body: 'Compose teams that claim work, hand off, and coordinate over a shared, durable bus — never peer-to-peer DMs. At most one agent holds a work item at a time, and a crashed agent’s work is safely reclaimed.',
  },
  {
    title: 'Observable by default',
    body: 'Every run emits OpenTelemetry traces and streams live over SSE. No black boxes: follow each tool call, model response, and log line as it happens, and ship the telemetry to any OTLP backend you already run.',
  },
];

const steps = [
  { n: '1', title: 'Compose CRDs', body: 'Declare a Team and its agents in YAML — each agent with a Role (how it behaves) and Skills (what tools it may use). Point a Project at a repo. kubectl apply.' },
  { n: '2', title: 'Squad spins up', body: 'The operator reconciles your objects into running agents, scheduling them as pods and wiring the coordination bus. Reconciliation is level-based — edit and re-apply, and the crew converges to match.' },
  { n: '3', title: 'Agents work', body: 'Agents claim work items, hand off, and coordinate through the durable bus. At most one holds an item at a time; a crashed agent’s work is reclaimed and re-dispatched. The coordination record is the audit trail.' },
  { n: '4', title: 'You monitor', body: 'Watch runs stream live, follow the traces, and inspect the artifacts — from the console or straight from kubectl. No orchestration code to write.' },
];

const screens = [
  { src: '/screens/01-squad-overview.png', alt: 'Squad overview — fleet of agents in formation' },
  { src: '/screens/08-fleet-dashboard.png', alt: 'Fleet dashboard' },
  { src: '/screens/02-run-stream-sse.png', alt: 'Live Run stream over SSE' },
  { src: '/screens/10-agent-runs.png', alt: 'Agent runs' },
  { src: '/screens/19-project-dashboard.png', alt: 'Per-project dashboard' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>K8squad — Your agents, in formation</title>
    <meta
      name="description"
      content="KSquad is a Kubernetes-native control plane for teams of AI agents. Compose squads as CRDs, let them claim work and coordinate over a shared bus, and watch every run live with OpenTelemetry."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://k8squad.io/" />
    <meta property="og:title" content="K8squad — Your agents, in formation" />
    <meta
      property="og:description"
      content="A Kubernetes-native control plane for teams of AI agents. Compose squads as CRDs, let them claim work and coordinate over a shared bus, and watch every run live with OpenTelemetry."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://k8squad.io/" />
    <meta property="og:image" content="https://k8squad.io/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
    />
    <!-- Apply persisted theme before paint; shares Starlight's localStorage key so
         the toggle stays consistent between the landing page and the docs. -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('starlight-theme');
        const theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">
        <img src="/mark-8crest.svg" alt="" width="28" height="28" />
        <span class="wordmark">K<span class="eight">8</span>squad</span>
      </a>
      <nav class="nav-links">
        <a href="/docs">Docs</a>
        <a href="/docs/concepts">Concepts</a>
        <a href="/docs/plugin-sdk">Plugin SDK</a>
        <a href="https://github.com/K8squad">GitHub</a>
      </nav>
      <div class="nav-actions">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme">◐</button>
        <a class="btn btn-primary" href="/docs/quickstart">Get started</a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Multi-agent orchestration for Kubernetes</p>
          <h1>Your agents, in formation.</h1>
          <p class="lede">
            Compose squads of AI agents as Kubernetes resources. They claim work, hand off, and
            coordinate — and you watch every run, live, with OpenTelemetry. Bring your own runtime,
            your own credentials, and your own model; KSquad reconciles the crew like any other
            cluster workload.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/docs/quickstart">Get started →</a>
            <a class="btn btn-ghost" href="https://github.com/K8squad">View on GitHub →</a>
          </div>
          <pre class="helm"><code>helm install ksquad ksquad/ksquad -n ksquad-system</code></pre>
        </div>
        <div class="hero-art">
          <img src="/hero-art.svg" alt="KSquad fleet overview" loading="eager" />
        </div>
      </section>

      <!-- What is KSquad -->
      <section class="band">
        <h2 class="section-title">What is KSquad?</h2>
        <div class="cards-3">
          {intro.map((c) => (
            <article class="card">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Features -->
      <section class="band">
        <h2 class="section-title">Everything you need to run agent squads</h2>
        <div class="features">
          {features.map((f) => (
            <article class="feature">
              <div class="feature-head">
                <span class="feature-n">{f.n}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- How it works -->
      <section class="band">
        <h2 class="section-title">How it works</h2>
        <div class="steps">
          {steps.map((s) => (
            <article class="step">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Screenshots -->
      <section class="band">
        <h2 class="section-title">See it in action</h2>
        <div class="carousel" role="region" aria-label="Console screenshots">
          {screens.map((s) => (
            <figure class="shot">
              <img src={s.src} alt={s.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </section>

      <!-- Get started -->
      <section class="band get-started">
        <h2 class="section-title">Get started in one command</h2>
        <p class="lede center">Install the operator, then open the console.</p>
        <pre class="helm big"><code>helm repo add ksquad https://charts.k8squad.io &amp;&amp; helm install ksquad ksquad/ksquad</code></pre>
        <div class="cta-row center">
          <a class="btn btn-primary" href="/docs/quickstart">Read the docs →</a>
          <a class="btn btn-ghost" href="https://github.com/K8squad">Star us on GitHub →</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="foot-cols">
        <div>
          <span class="wordmark small">K<span class="eight">8</span>squad</span>
          <p class="muted">Your agents, in formation.</p>
        </div>
        <div>
          <h4>Product</h4>
          <a href="/docs/quickstart">Quickstart</a>
          <a href="/docs/concepts">Concepts</a>
          <a href="/docs/operator-guide">Operator Guide</a>
        </div>
        <div>
          <h4>Docs</h4>
          <a href="/docs">Overview</a>
          <a href="/docs/plugin-sdk">Plugin SDK</a>
          <a href="/docs/api-reference">API Reference</a>
        </div>
        <div>
          <h4>Community</h4>
          <a href="https://github.com/K8squad">GitHub</a>
          <a href="/docs/troubleshooting">Troubleshooting</a>
        </div>
      </div>
      <div class="foot-legal">
        <span class="muted">Apache 2.0 · © 2026 K8squad</span>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
      });
    </script>

    <style is:global>
      :root {
        --azure: #3d7dff;
        --font: 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        --mono: 'Geist Mono', ui-monospace, 'SFMono-Regular', 'Menlo', monospace;
      }
      html[data-theme='dark'] {
        --bg: #0f1117;
        --card: #1a1d29;
        --border: #262b3a;
        --text: #e8eef9;
        --text-2: #b6c3d8;
        --text-3: #7e8ca6;
        --nav-bg: rgba(15, 17, 23, 0.8);
      }
      html[data-theme='light'] {
        --bg: #f6f8fc;
        --card: #ffffff;
        --border: #e2e8f2;
        --text: #10131c;
        --text-2: #38435c;
        --text-3: #5a6883;
        --nav-bg: rgba(246, 248, 252, 0.85);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      code, pre { font-family: var(--mono); }
      a { color: inherit; text-decoration: none; }
      main { display: block; }
      section { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

      /* Nav */
      .nav {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; gap: 24px;
        padding: 14px 24px;
        background: var(--nav-bg); backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; }
      .wordmark { font-size: 1.15rem; letter-spacing: -0.01em; }
      .wordmark.small { font-size: 1rem; }
      .eight { color: var(--azure); }
      .nav-links { display: flex; gap: 22px; margin-left: 12px; color: var(--text-2); font-size: 0.95rem; }
      .nav-links a:hover { color: var(--text); }
      .nav-actions { margin-left: auto; display: flex; align-items: center; gap: 12px; }
      .theme-toggle {
        background: transparent; border: 1px solid var(--border); color: var(--text-2);
        width: 34px; height: 34px; border-radius: 8px; cursor: pointer; font-size: 1rem;
      }
      .theme-toggle:hover { color: var(--text); border-color: var(--azure); }

      .btn {
        display: inline-block; padding: 10px 18px; border-radius: 10px;
        font-weight: 500; font-size: 0.95rem; transition: transform .05s ease, background .15s ease;
      }
      .btn:active { transform: translateY(1px); }
      .btn-primary { background: var(--azure); color: #fff; }
      .btn-primary:hover { background: #2f6bf0; }
      .btn-ghost { border: 1px solid var(--border); color: var(--text); }
      .btn-ghost:hover { border-color: var(--azure); }

      /* Hero */
      .hero {
        max-width: 1120px; margin: 0 auto; padding: 72px 24px 40px;
        display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center;
      }
      .eyebrow { color: var(--azure); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.02em; margin: 0 0 14px; }
      .hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 18px; }
      .lede { color: var(--text-2); font-size: 1.1rem; max-width: 46ch; }
      .lede.center { margin: 0 auto 20px; text-align: center; }
      .cta-row { display: flex; gap: 14px; margin: 26px 0; flex-wrap: wrap; }
      .cta-row.center { justify-content: center; }
      .helm {
        background: #0b0d13; border: 1px solid var(--border); border-radius: 10px;
        padding: 14px 16px; overflow-x: auto; font-size: 0.85rem; color: #cdd6ea; margin: 0;
      }
      .helm.big { max-width: 720px; margin: 18px auto 26px; }
      .hero-art img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: 14px; }

      /* Bands */
      .band { padding: 56px 24px; }
      .section-title { font-size: 1.7rem; letter-spacing: -0.01em; margin: 0 0 28px; }

      .cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px; }
      .card h3 { margin: 0 0 8px; font-size: 1.1rem; }
      .card p { margin: 0; color: var(--text-2); font-size: 0.95rem; }

      .features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
      .feature { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px; }
      .feature-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
      .feature-icon { width: 42px; height: 42px; display: block; }
      .feature-n { color: var(--azure); font-family: var(--mono); font-size: 0.8rem; }
      .feature h3 { margin: 0 0 8px; font-size: 1.08rem; }
      .feature p { margin: 0; color: var(--text-2); font-size: 0.93rem; }

      .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
      .step { position: relative; padding: 22px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
      .step-n {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px; background: var(--azure); color: #fff;
        font-weight: 600; margin-bottom: 12px;
      }
      .step h3 { margin: 0 0 8px; font-size: 1rem; }
      .step p { margin: 0; color: var(--text-2); font-size: 0.9rem; }

      .carousel {
        display: flex; gap: 16px; overflow-x: auto; padding-bottom: 12px;
        scroll-snap-type: x mandatory;
      }
      .shot { flex: 0 0 auto; width: 520px; max-width: 82vw; margin: 0; scroll-snap-align: center; }
      .shot img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: 12px; }

      .get-started { text-align: center; }

      /* Footer */
      .footer { border-top: 1px solid var(--border); margin-top: 40px; padding: 48px 24px 32px; }
      .foot-cols { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 28px; }
      .foot-cols h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 12px; }
      .foot-cols a { display: block; color: var(--text-2); font-size: 0.92rem; padding: 3px 0; }
      .foot-cols a:hover { color: var(--text); }
      .muted { color: var(--text-3); font-size: 0.9rem; }
      .foot-legal { max-width: 1120px; margin: 28px auto 0; padding-top: 20px; border-top: 1px solid var(--border); }

      @media (max-width: 880px) {
        .hero { grid-template-columns: 1fr; padding-top: 40px; }
        .hero-art { order: -1; }
        .cards-3, .features, .steps { grid-template-columns: 1fr; }
        .nav-links { display: none; }
        .foot-cols { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
