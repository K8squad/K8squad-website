# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the event relay
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o event-relay ./cmd/event-relay

# Final stage
FROM alpine:latest

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy binary from builder
COPY --from=builder /app/event-relay .

# Copy configuration template
COPY --from=builder /app/deployment/event-relay-deployment.yaml /root/config-template.yaml

# Expose metrics port
EXPOSE 8080

# Run the event relay
CMD ["./event-relay"]