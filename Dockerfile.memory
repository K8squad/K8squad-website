# ksquad-memory service (Story 6.1 / ISI-2716) — builds ./cmd/memory.
# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go mod files and download dependencies (cached layer).
COPY go.mod go.sum ./
RUN go mod download

# Copy source (includes db/migrations, embedded into the binary via db/embed.go).
COPY . .

# Build the memory service.
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o memory ./cmd/memory

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/memory .

# Health/readiness port
EXPOSE 8080

# The service applies db/migrations against DATABASE_URL and fails closed if pgvector is absent.
CMD ["./memory"]
